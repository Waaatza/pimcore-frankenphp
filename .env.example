# Copy the required names into your application's untracked environment file.
# Never commit real values.
APP_ENV=dev
APP_DEBUG=1

DATABASE_URL=mysql://pimcore:change-me@db/pimcore
PIMCORE_OPENSEARCH_DSN=https://admin:change-me@opensearch:9200
PIMCORE_MESSENGER_TRANSPORT_DSN_PREFIX=amqp://guest:guest@rabbitmq:5672

# Generate with: openssl rand -hex 32
MERCURE_JWT_KEY=replace-with-a-random-secret-of-at-least-32-bytes
MERCURE_URL=http://localhost/.well-known/mercure
MERCURE_SERVER_URL=http://frankenphp/.well-known/mercure

OPENSEARCH_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-local-password
